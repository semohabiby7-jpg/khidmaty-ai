#!/usr/bin/env bash
# منع رفع أي مفتاح أو توكن داخل الكوميت
set -u
PATTERNS=(
  'ghp_[A-Za-z0-9]{20,}'
  'gho_[A-Za-z0-9]{20,}'
  'github_pat_[A-Za-z0-9_]{20,}'
  'sk-[A-Za-z0-9]{20,}'
  'AIza[0-9A-Za-z_-]{30,}'
  'AKIA[0-9A-Z]{16}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  'https://[^/@[:space:]]+:[^/@[:space:]]+@github\.com'
  '-----BEGIN (RSA|OPENSSH|EC|PGP) PRIVATE KEY-----'
)
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0
found=0
for f in $files; do
  [ -f "$f" ] || continue
  for p in "${PATTERNS[@]}"; do
    if grep -IqE "$p" "$f" 2>/dev/null; then
      hit=$(grep -InoE "$p" "$f" | head -3 | cut -d: -f1 | tr '\n' ' ')
      echo "❌ مفتاح محتمل في: $f (سطر: $hit) — نوع: ${p:0:12}..."
      found=1
    fi
  done
done
if [ "$found" = "1" ]; then
  echo ""
  echo "الرفع اتوقف. شيل المفتاح من الملف، أو لو ده ملف مقصود قول: git commit --no-verify"
  exit 1
fi
exit 0
